{
    // Triangulation default parameters
    "buffer_window_size": {
        "type": "int",
        "default": 300,
        "description": "Size of the buffer window for triangulation, in frames."
    },
    "iou_threshold": {
        "type": "float",
        "default": 10.0,
        "description": "Distance in meters between two detections to be considered the same object for triangulation."
    },
    "update_rate": {
        "type": "float",
        "default": 0.5,
        "description": "Rate at which to update the triangulation in seconds."
    },

    // Inference default parameters.
    "threshold": {
        "type": "float",
        "default": 0.25,
        "description": "Confidence threshold for object detection."
    },
    "model_name": {
        "type": "string",
        "default": "yolo26s",
        "description": "Name of the model to use for object detection. This should match the name used in the config file and the engine file."
    },
    "jpg_compression_ratio": {
        "type": "int",
        "default": 50,
        "description": "Compression ratio for JPEG images."

    }
}