# Server ports for the ground station.
# Keep all three consumers in sync by editing ONLY this file.

# Python ThreadingHTTPServer for waypoint exchange between the map JS and PyQt.
MAP_CALLBACK_PORT=8001

# Vite dev server that serves the map widget HTML/JS/CSS to the QWebEngineView.
MAP_VIEWER_PORT=5173

# Python TCPServer (SimpleHTTPRequestHandler) that serves static assets
# (marker icons, boat icon, easter egg audio) to the map frontend.
ASSET_SERVER_PORT=8000
